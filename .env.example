# Variáveis opcionais. O servidor lê o ambiente; não carrega .env automaticamente.
# Caminhos absolutos são recomendados. Default do DB: ./var/ummix.sqlite3
UMMIX_DB_PATH=./var/ummix.sqlite3
# Sem override, usa o seed empacotado em src/ummix_mcp/data/mock_inventory.json.
# UMMIX_INVENTORY_PATH=C:/caminho/mock_inventory.json
# Aprovações duram 30 minutos. Não é necessária chave de LLM.
# Web: procura o binário nativo no PATH e na instalação desktop do Codex.
# Override opcional, sem aspas como parte do valor e sem argumentos shell:
# UMMIX_CODEX_PATH=C:/caminho/codex.exe
# UMMIX_WEB_DB_PATH=./var/web.sqlite3
